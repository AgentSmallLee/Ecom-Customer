{
  "name": "ecom-ai-customer-server",
  "version": "1.0.0",
  "description": "红松心选 AI 客服系统 — 后端服务",
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "dev": "nodemon --watch src --ext ts --exec tsx src/main.ts",
    "start": "tsx src/main.ts",
    "init-db": "tsx src/scripts/init-db.ts",
    "ingest": "tsx src/scripts/ingest.ts",
    "eval-recall": "tsx src/evaluation/eval-recall.ts",
    "eval-precision": "tsx src/evaluation/eval-precision.ts",
    "eval-generation": "tsx src/evaluation/eval-generation.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@langchain/community": "^1.1.27",
    "@langchain/core": "^1.1.38",
    "@langchain/langgraph": "^1.2.9",
    "@langchain/langgraph-checkpoint": "^1.1.5",
    "@langchain/langgraph-checkpoint-postgres": "^1.0.5",
    "@langchain/openai": "^1.4.4",
    "@langchain/textsplitters": "^1.0.1",
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.3",
    "langchain": "^1.2.39",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "uuid": "^14.0.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.4.1",
    "@types/pg": "^8.23.1",
    "@types/uuid": "^11.0.0",
    "nodemon": "^3.1.4",
    "prisma": "^7.10.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  }
}
