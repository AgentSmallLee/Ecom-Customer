# ─── 对话模型（主模型，所有功能必填）────────────────────────────
PRIMARY_API_KEY=
PRIMARY_BASE_URL=
PRIMARY_MODEL=
PORT=

# 降级模型
FALLBACK_MODEL=
FALLBACK_API_KEY=
FALLBACK_BASE_URL=
LLM_FALLBACK_TEXT=

# ─── Embedding 模型（RAG 功能必填，二选一）───────────────────────
# 方式一：智谱 AI（推荐）https://open.bigmodel.cn
#ZHIPU_API_KEY=

# 方式二：阿里云百炼  https://bailian.console.aliyun.com
DASHSCOPE_API_KEY=

# ─── PostgreSQL（RAG 功能必填）───────────────────────────────────
PG_HOST=
PG_PORT=
PG_USER=
PG_PASSWORD=
PG_DATABASE=

# ─── 记忆功能（Graph 工作流，可选，留空使用默认值）───────────────
# 对话消息数超过该阈值时触发 LLM 压缩摘要
MEMORY_SUMMARY_THRESHOLD=10
# 压缩后保留的最近消息条数
MEMORY_KEEP_RECENT=4

# 数据库连接字符串
DATABASE_URL=


# 是否启用Langsmith监控功能
LANGSMITH_TRACING=true
# 创建的API_KEY
LANGSMITH_API_KEY=
# 自定义项目名称，可以在Langsmith WebUI监控页面根据名称查看对应的运行记录
LANGSMITH_PROJECT=