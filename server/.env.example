# ─── 对话模型（DeepSeek，所有功能必填）────────────────────────────
DEEPSEEK_API_KEY=换成你的DeepSeek API Key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
MODEL_NAME=deepseek-chat
PORT=3000

# ─── Embedding 模型（RAG 功能必填，二选一）───────────────────────
# 方式一：智谱 AI（推荐）https://open.bigmodel.cn
ZHIPU_API_KEY=换成你的sk

# 方式二：阿里云百炼  https://bailian.console.aliyun.com
# DASHSCOPE_API_KEY=你的百炼APIKey

# ─── PostgreSQL（RAG + 记忆功能必填）─────────────────────────────
PG_HOST=
PG_PORT=
PG_USER=
PG_PASSWORD=
PG_DATABASE=

# ─── 记忆功能（Graph 工作流，可选，留空使用默认值）───────────────
# 对话消息数超过该阈值时触发 LLM 压缩摘要
MEMORY_SUMMARY_THRESHOLD=10
# 压缩后保留的最近消息条数
MEMORY_KEEP_RECENT=4
